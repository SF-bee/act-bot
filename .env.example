# ============ ACT Bot 部署配置（示例）============
# 用法：复制为 .env 并填写。.env 保存凭据与机器相关配置，绝不入库。
# 提示：NoneBot 启动时会自动加载项目根目录的 .env（本地开发用这一份即可）；
#       如需区分环境可另建 .env.prod（优先级高于 .env）。

# ---- NoneBot 运行设置 ----
DRIVER=~fastapi+~httpx+~websockets
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# 命令前缀（默认 "/"；多个用逗号分隔，例如：[ "/", "！" ]）
# COMMAND_START=["/"]
# 反向 WS 接入 token（协议端配置需一致；留空表示不校验。公网环境务必设置！）
ONEBOT_ACCESS_TOKEN=

# ---- ACT Bot 应用设置（ACTBOT_ 前缀）----
# 数据目录（默认 data/；相对路径以仓库根为基准，也可写绝对路径）
ACTBOT_DATA_DIR=data
# 时区（IANA 名称）
ACTBOT_TIMEZONE=Asia/Shanghai
# 首次部署时写入 owner 的管理员 QQ（仅 bootstrap_admin.py 使用；完成后可清空）
ACTBOT_BOOTSTRAP_ADMIN_QQ=
# 【联调可选】真实协议端 WS 地址与 token（仅 scripts/smoke_protocol.py 使用）
ACTBOT_PROTOCOL_WS_URL=
ACTBOT_PROTOCOL_TOKEN=
