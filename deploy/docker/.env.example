# ============ deploy/docker 专用变量（示例）============
# 用法：复制为 deploy/docker/.env（或直接用命令行传入变量）。
# 注意：机器人凭据（ONEBOT_ACCESS_TOKEN 等）仍放在仓库根 .env，不在这里重复。

# Linux 宿主机：填 id -u / id -g 的结果；Windows / macOS 保持默认即可
NAPCAT_UID=1000
NAPCAT_GID=1000

# 快速登录（免扫码）：填机器人 QQ 号，compose 会作为 ACCOUNT 传给 NapCat，
# 镜像 entrypoint 见到它就执行 `qq -q $ACCOUNT`。留空则每次重建都要扫码。
# 只写在本文件（.env 不入库），绝不写进仓库代码。
NAPCAT_QQ=

# 业务层 env 文件位置（相对 deploy/docker/，也可写绝对路径）
ACTBOT_ENV_FILE=../../.env

# 时区（IANA 名称，写入业务层 ACTBOT_TIMEZONE）
ACTBOT_TIMEZONE=Asia/Shanghai
