# ============ deploy/docker 专用变量（示例）============
# 用法：复制为 deploy/docker/.env（或直接用命令行传入变量）。
# 注意：机器人凭据（ONEBOT_ACCESS_TOKEN 等）仍放在仓库根 .env，不在这里重复。

# Linux 宿主机：填 id -u / id -g 的结果；Windows / macOS 保持默认即可
NAPCAT_UID=1000
NAPCAT_GID=1000

# 固定网卡 MAC：NapCat 设备指纹 = MD5(/etc/machine-id + 容器 MAC)，Docker 每次重建
# 容器都会换 MAC，腾讯便判定「新设备」并要求验证。留空则用 compose 默认值；
# 老部署想保住现有设备身份，把当前 MAC 填到这里：
#   docker inspect act-napcat --format '{{range .NetworkSettings.Networks}}{{.MacAddress}}{{end}}'
NAPCAT_MAC=

# 快速登录（免扫码）：填机器人 QQ 号，compose 会作为 ACCOUNT 传给 NapCat，
# 镜像 entrypoint 见到它就执行 `qq -q $ACCOUNT`。留空则每次重建都要扫码。
# 只写在本文件（.env 不入库），绝不写进仓库代码。
NAPCAT_QQ=

# 回退密码（强烈建议填）：快速登录的登录态被腾讯回收时，NapCat 用密码自动重登，免去人工扫码。
# QQ 密码是高价值凭据：务必用专用机器人号，不要复用个人密码；只写在本文件（不入库）。填任一即可：
#   NAPCAT_QUICK_PASSWORD      —— 明文密码（NapCat 在内存里算 MD5，推荐）
#   NAPCAT_QUICK_PASSWORD_MD5  —— 32 位 MD5（避开明文落盘，强度等同密码）
# 留空则掉线后退化为二维码登录，需要人工扫码。
NAPCAT_QUICK_PASSWORD=
# NAPCAT_QUICK_PASSWORD_MD5=

# NapCat 镜像 tag（= NapCat 版本，镜像自带对应 QQ 版本）。
# latest = 最新；想降级/回滚就填具体 tag（如 v4.18.33 / v4.17.0 / v4.15.0）。
# 社区曾实测 v4.15.0 更稳，但那是几个月前，旧 QQ 可能已被腾讯禁止登录。
NAPCAT_IMAGE_TAG=latest

# 钉死镜像（推荐生产）：填完整引用，优先级高于 NAPCAT_IMAGE_TAG。
# 镜像里烘焙着 /etc/machine-id，它参与 NapCat 设备指纹 —— 换镜像 = 换设备，
# 于是 latest 下一次 pull 就可能让腾讯弹「新设备验证」。钉死后 pull 不再改变镜像。
#   NAPCAT_IMAGE=mlikiowa/napcat-docker@sha256:<digest>
# 取 digest：docker image inspect mlikiowa/napcat-docker:latest --format '{{index .RepoDigests 0}}'
# NAPCAT_IMAGE=

# 业务层 env 文件位置（相对 deploy/docker/，也可写绝对路径）
ACTBOT_ENV_FILE=../../.env

# 时区（IANA 名称，写入业务层 ACTBOT_TIMEZONE）
ACTBOT_TIMEZONE=Asia/Shanghai
